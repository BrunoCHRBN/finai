# Database URL (local SQLite file)
DATABASE_URL="file:./finai.db"

# Google Gemini API Key & Multi-Model Architecture (Sprint 5/6/7)
# Get your key at: https://aistudio.google.com/app/apikey
# IMPORTANT: Never prefix GEMINI_API_KEY with NEXT_PUBLIC_
GEMINI_API_KEY="your_gemini_api_key_here"
# Fast model: gemini-3.5-flash-lite (fallback: gemini-3.1-flash-lite)
GEMINI_FAST_MODEL="gemini-3.5-flash-lite"
# Advanced model: gemini-3.8-flash (fallback: gemini-3.6-flash)
GEMINI_ADVANCED_MODEL="gemini-3.8-flash"
GEMINI_CHAT_MAX_OUTPUT_TOKENS="900"
GEMINI_ADVANCED_MAX_OUTPUT_TOKENS="1800"
GEMINI_FAST_TIMEOUT_MS="9000"
GEMINI_ADVANCED_TIMEOUT_MS="18000"

# Pluggy Open Finance API (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID="your_pluggy_client_id_here"
PLUGGY_CLIENT_SECRET="your_pluggy_client_secret_here"

# Brapi Market Data API (https://brapi.dev)
# Used exclusively on the backend for B3 market quotes and indices
BRAPI_API_TOKEN="your_brapi_api_token_here"

