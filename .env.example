# Pluggy Open Finance API Credentials (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=your_pluggy_client_id_uuid
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret
PLUGGY_BASE_URL=https://api.pluggy.ai

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Remote LibSQL / Turso Database URL (Defaults to local SQLite file: finai.db)
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=your_auth_token
